rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Coleção de Usuários / Perfis
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Configurações do App (ex: Tema da semana)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Desafios
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if true;
    }

    // Solicitações de participação em desafios
    match /challenge_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Participantes de desafios (ranking/acesso)
    match /challenge_participants/{participantId} {
      allow read: if true;
      allow write: if true;
    }

    // Grupos
    match /groups/{groupId} {
      allow read: if true;
      allow write: if true;
      
      match /members/{memberId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Membros de grupo na coleção raiz
    match /group_members/{memberDocId} {
      allow read: if true;
      allow write: if true;
    }

    // Tarefas Extras (Tasks)
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }
    match /extra_tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Check-ins
    match /checkins/{checkinId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      match /reactions/{userId} {
        allow read, write: if true;
      }

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Comentários em coleção raiz
    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
