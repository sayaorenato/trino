rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regras para fotos de check-in
    match /checkins/{allPaths=**} {
      allow read, write: if true;
    }

    // Regras para avatares de perfil
    match /avatars/{userId} {
      allow read, write: if true;
    }
  }
}
